# 데이터베이스 설정
DB_URL=jdbc:postgresql://localhost:5432/travel
DB_USER=travel
DB_PASSWORD=your_secure_password_here

# JWT 설정
JWT_SECRET=your_very_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=3600000

# UUID 암호화 설정
UUID_CRYPTO_SECRET=your_32_character_crypto_secret_key_here

# Redis 설정
REDIS_HOST=localhost
REDIS_PORT=6379

# 파일 업로드 경로
FILE_UPLOAD_PATH=/path/to/upload/files/
IMAGE_UPLOAD_PATH=/path/to/upload/images/
THUMBNAIL_UPLOAD_PATH=/path/to/upload/thumbnails/

# 파일 확장자 설정
FILE_ALLOWED_EXTENSION=pdf,csv,txt
IMAGE_ALLOWED_EXTENSION=png,jpg,jpeg,gif

# 서버 설정
SSL_ENABLED=false
SERVER_PORT=8080

# 모니터링 설정
ACTUATOR_ENDPOINTS=health,info
ACTUATOR_HEALTH_DETAILS=when-authorized

# 파일 업로드 크기 제한
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB

# 1분당 실행제한
RATE_LIMIT_API_COUNT=100
RATE_LIMIT_AUTH_COUNT=100
RATE_RETRY_AFTER=60

# 프로덕션 환경에서는 다음 설정을 사용하세요:
# SSL_ENABLED=true
# JWT_SECRET=매우_긴_랜덤_시크릿_키_최소_64자_이상
# UUID_CRYPTO_SECRET=32자_정확한_암호화_키
# DB_PASSWORD=매우_강력한_데이터베이스_비밀번호

